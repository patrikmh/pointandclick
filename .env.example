# Required. Create a key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Text conversations and painting review can be tuned independently.
OPENROUTER_CHAT_MODEL=~google/gemini-flash-latest
OPENROUTER_VISION_MODEL=~google/gemini-flash-latest
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional ElevenLabs voice support for the shrimp conversation game.
# Required for both TTS (streamed reply audio) and STT (realtime Scribe transcription
# while Starta samtal is active). Without these the shrimp game stays playable via its
# Web Speech API / MediaRecorder fallback, but live voice chat is inert.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=Xb7hH8MSUJpSbSDYk0k2
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_STT_MODEL=scribe_v2
# realtime Scribe uses scribe_v2_realtime over WebSocket and bills credits per second of open mic.
SHRIMP_STT_KEYTERMS="piano, hål, fel, Greta Thunberg, räkor"

# Optional OpenRouter attribution headers.
OPENROUTER_SITE_URL=http://127.0.0.1:3000
OPENROUTER_APP_NAME="Adventure Scene"

# Server and safety limits.
HOST=127.0.0.1
PORT=3000
UPSTREAM_TIMEOUT_MS=30000
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_WINDOW_MS=60000

# Röst per karaktär (ElevenLabs). Saknas ett id används ELEVENLABS_VOICE_ID.
# Samma röst bör användas när klippen i VOICE_SCRIPT.md genereras, så att
# förinspelade repliker och live-talad chatt låter likadant.
ELEVENLABS_VOICE_MOON=
ELEVENLABS_VOICE_SEAL=
ELEVENLABS_VOICE_OCTO=
ELEVENLABS_VOICE_BADGER=
ELEVENLABS_VOICE_OTTER=
ELEVENLABS_VOICE_GULL=
ELEVENLABS_VOICE_CRAB=
ELEVENLABS_VOICE_COD=
ELEVENLABS_VOICE_SUB=
ELEVENLABS_VOICE_SHEEP=
ELEVENLABS_VOICE_SHRIMP=
ELEVENLABS_VOICE_NARRATOR=
